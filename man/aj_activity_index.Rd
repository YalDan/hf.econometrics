\examples{
set.seed(1)
n <- 23400
s <- 0.25 * sqrt(1 / (252 * n)) # sd of a 1-second Brownian increment
# Brownian motion plus Cauchy jumps (beta = 1), 1\% of them above 7 sd
dx <- rnorm(n, 0, s) + rcauchy(n, scale = 0.01 * pi * 7 * s / 2)
aj_activity_index(cumsum(c(0, dx)))
}
